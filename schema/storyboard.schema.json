{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritage-short-ai.local/schema/storyboard.schema.json",
  "title": "Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "logline",
    "aspect_ratio",
    "fps",
    "total_duration_seconds",
    "characters",
    "vehicles",
    "shots"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string",
      "minLength": 1
    },
    "aspect_ratio": {
      "type": "string",
      "enum": ["9:16", "16:9"]
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "total_duration_seconds": {
      "type": "number",
      "minimum": 60,
      "maximum": 90
    },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "vehicles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration_seconds",
          "scene_description",
          "narrative_purpose",
          "image_prompt",
          "negative_prompt",
          "motion_prompt",
          "character_refs",
          "vehicle_refs",
          "narration_am",
          "subtitle_en",
          "music_cue",
          "sfx_cues",
          "camera",
          "seed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scene_description": {
            "type": "string",
            "minLength": 1
          },
          "narrative_purpose": {
            "type": "string",
            "minLength": 1
          },
          "image_prompt": {
            "type": "string",
            "minLength": 1
          },
          "negative_prompt": {
            "type": "string",
            "minLength": 1
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 1
          },
          "character_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "vehicle_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "narration_am": {
            "type": "string",
            "minLength": 1
          },
          "subtitle_en": {
            "type": "string",
            "minLength": 1
          },
          "music_cue": {
            "type": "string",
            "minLength": 1
          },
          "sfx_cues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": ["framing", "movement"],
            "properties": {
              "framing": {
                "type": "string",
                "minLength": 1
              },
              "movement": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
